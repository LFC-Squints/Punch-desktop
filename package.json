{
  "name": "punch-desktop",
  "version": "2.2.0",
  "description": "Self-hosted desktop time tracker with subcategories, tasks, accounts, hotkeys, nudges, daily closeouts, and AI summary export",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always"
  },
  "author": "Justin",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "electron-updater": "^6.3.9",
    "get-windows": "^9.2.0"
  },
  "build": {
    "appId": "com.justin.punch",
    "productName": "Punch",
    "asarUnpack": ["node_modules/canvas/**/*"],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Punch",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowElevation": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "assets/installer.nsh"
    },
    "portable": {
      "artifactName": "Punch-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "LFC-Squints",
      "repo": "Punch-desktop"
    }
  }
}
